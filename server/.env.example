# OneOS 服务器生产环境配置
# 复制此文件为 .env 并修改为实际值

# 运行环境
NODE_ENV=production

# 服务器端口
PORT=3001

# JWT 密钥（生产环境必须修改为强随机字符串！）
# 生成方法：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=please-change-this-to-a-strong-random-secret-key

# JWT 过期时间（天）
JWT_EXPIRES_DAYS=30

# 数据库路径
DB_PATH=./data/oneos.db

# 允许的前端来源（CORS），多个用逗号分隔
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 服务器公网地址（用于二维码、分享链接等）
PUBLIC_BASE_URL=http://your-domain.com

# 日志级别：debug, info, warn, error
LOG_LEVEL=info

# 数据备份目录
BACKUP_DIR=./backups

# 每日备份时间（24小时制，如 03:00）
BACKUP_TIME=03:00

# 保留备份天数
BACKUP_RETENTION_DAYS=30
