        if (btn) { btn.disabled = true; btn.innerHTML = '<i data-lucide="loader-2" class="lucide icon-white"></i>杩愯涓?..'; renderIcons(); }
        const cells = document.querySelectorAll('.nb-cell');
        let index = 0;
        const runNext = () => {
          if (index >= cells.length) {
            if (btn) { btn.innerHTML = '<i data-lucide="play" class="lucide icon-white"></i>杩愯鍏ㄩ儴'; btn.disabled = false; }
            if (typeof UI !== 'undefined') UI.toast.success(`鍏ㄩ儴 ${cells.length} 涓崟鍏冩牸杩愯瀹屾垚`);
            renderIcons();
            return;
          }
          const cell = cells[index];
          const status = cell.querySelector('.nb-cell-header span:last-child');
          if (status) { status.textContent = '杩愯涓?..'; status.style.color = 'var(--orange)'; }
          setTimeout(() => {
            if (status) { status.textContent = '宸插畬鎴?; status.style.color = 'var(--green)'; }
            index++;
            runNext();
          }, 400);
        };
        runNext();
      }
    });
