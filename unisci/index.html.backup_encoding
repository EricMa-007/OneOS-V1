<script>
// ===== 瀵艰埅绯荤粺 (宸茬敱 core.js 鎻愪緵瀹屾暣瀹炵幇锛屾澶勪繚鐣欏吋瀹瑰彉閲? =====
// 娉ㄦ剰: navigateTo/goBack/switchTab/showToast/_store 绛夊叏灞€鍑芥暟鐢?core.js 鎻愪緵
let pageHistory = ['page-home'];
let currentPage = 'page-home';
let currentData = {};
// 鍏ㄥ眬瀵艰埅鏁版嵁瀛樺偍锛氶伩鍏嶅唴鑱擩SON瀵艰嚧寮曞彿杞箟闂
const _navStore = {};
let _navCounter = 0;
function _store(data) { const id = 'nd' + (++_navCounter); _navStore[id] = data; return id; }

function navigateTo(pageId, data) {
  // 濡傛灉data鏄瓧绗︿覆涓斾互'nd'寮€澶达紝浠庡叏灞€瀛樺偍鑾峰彇
  if (typeof data === 'string' && data.startsWith('nd') && _navStore[data]) {
    data = _navStore[data];
  }
  if (data) currentData[pageId] = data;
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const target = document.getElementById(pageId);
  if (target) {
    target.classList.add('active');
    if (pageId !== currentPage) pageHistory.push(pageId);
    currentPage = pageId;
    window.scrollTo({top:0,behavior:'smooth'});
    // 瀛愰〉闈㈤殣钘忓簳閮ㄥ鑸拰FAB
    const isSub = target.classList.contains('sub-page');
    document.querySelector('.bottom-nav').style.display = isSub ? 'none' : 'flex';
    document.querySelector('.fab').style.display = isSub ? 'none' : 'flex';
    // 娓叉煋瀛愰〉闈㈠唴瀹?
    renderSubPage(pageId);
    renderIcons();
  }
}

function goBack() {
  if (pageHistory.length > 1) {
    pageHistory.pop();
    const prev = pageHistory[pageHistory.length - 1];
    currentPage = prev;
    document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
    document.getElementById(prev).classList.add('active');
    const isSub = document.getElementById(prev).classList.contains('sub-page');
    document.querySelector('.bottom-nav').style.display = isSub ? 'none' : 'flex';
    document.querySelector('.fab').style.display = isSub ? 'none' : 'flex';
    // 鏇存柊搴曢儴瀵艰埅婵€娲荤姸鎬?
    const tabMap = {'page-home':'home','page-compute':'compute','page-learn':'learn','page-ai':'ai','page-profile':'profile'};
    if (tabMap[prev]) {
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      document.querySelector('.nav-item[data-page="'+tabMap[prev]+'"]').classList.add('active');
    }
    window.scrollTo({top:0,behavior:'smooth'});
    renderIcons();
  }
}

function switchTab(tab) {
  pageHistory = ['page-'+tab];
  currentPage = 'page-'+tab;
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  document.getElementById('page-'+tab).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  document.querySelector('.nav-item[data-page="'+tab+'"]').classList.add('active');
  document.querySelector('.bottom-nav').style.display = 'flex';
  document.querySelector('.fab').style.display = 'flex';
  window.scrollTo({top:0,behavior:'smooth'});
  renderIcons();
}

// ===== 鍥炬爣娓叉煋 =====
function renderIcons() {
  if (window.lucide && typeof window.lucide.createIcons === 'function') {
    window.lucide.createIcons();
  } else {
    setTimeout(renderIcons, 100);
  }
}

// ===== Toast =====
function showToast(msg) {
  const t = document.getElementById('toast');
