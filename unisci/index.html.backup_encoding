        UI.toast.success('任务已提交，正在排队...');
      } else {
        showToast('任务已提交，正在排队...');
      }
      setTimeout(() => {
        if (typeof switchTab === 'function') switchTab('compute');
      }, 1000);
      return;
    } catch(e) {
      console.error('创建任务失败:', e);
