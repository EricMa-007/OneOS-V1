function iconColorClass(color) {
  const map = { primary:'var(--primary)', blue:'var(--blue)', green:'var(--green)', purple:'var(--purple)', orange:'var(--primary)', yellow:'var(--yellow)' };
  return map[color] || 'var(--text2)';
}
function progressColorClass(p) { if(p>=80)return'pf-green'; if(p>=50)return'pf-blue'; if(p>=20)return'pf-orange'; return'pf-purple'; }

function selectChip(el) {
