<div class="page sub-page" id="page-search">
<div class="sub-header"><button class="back-btn" onclick="goBack()"><i data-lucide="arrow-left" class="lucide"></i></button><div class="sub-title">鎼滅储</div></div>
<div class="container">
  <div class="card" style="padding:12px 16px;margin-bottom:16px"><input class="form-input" id="search-input" placeholder="鎼滅储浠诲姟銆佽绋嬨€佹枃绔犮€佹潗鏂?.." autofocus style="margin-bottom:0" oninput="handleSearchInput(this.value)" onkeydown="if(event.key==='Enter')handleSearchSubmit(this.value)"></div>
  <div id="search-suggestions"></div>
  <div id="search-results" style="display:none"></div>
  <div id="search-default">
    <div class="section-header"><div class="section-title" style="font-size:15px"><i data-lucide="clock" class="lucide" style="width:16px;height:16px;color:var(--text3)"></i>鏈€杩戞悳绱?/div><div class="section-more" onclick="Search.clearHistory();document.getElementById('search-history-chips').innerHTML='';UI.toast.success('宸叉竻闄ゆ悳绱㈠巻鍙?)" style="cursor:pointer">娓呴櫎</div></div>
    <div class="chip-row" id="search-history-chips"></div>
    <div class="section-header" style="margin-top:20px"><div class="section-title" style="font-size:15px"><i data-lucide="trending-up" class="lucide" style="width:16px;height:16px;color:var(--primary)"></i>鐑棬鎼滅储</div></div>
    <div id="search-hot-list"></div>
  </div>
</div>
</div>
<script>
// 鎼滅储椤甸潰鍒濆鍖?
function initSearchPage() {
  // 娓叉煋鎼滅储鍘嗗彶
  const historyChips = document.getElementById('search-history-chips');
  if (historyChips && Search.history.length > 0) {
    historyChips.innerHTML = Search.history.slice(0,8).map(h => '<span class="chip" onclick="document.getElementById(\'search-input\').value=\''+h+'\';handleSearchSubmit(\''+h+'\')">'+h+'</span>').join('');
  }
  // 娓叉煋鐑棬鎼滅储
  const hotList = document.getElementById('search-hot-list');
  if (hotList) {
    const hotData = [
      {title:'瀹ゆ俯瓒呭鏉愭枡',count:'12.3涓囨鎼滅储',icon:'flame',color:'#ffb8a0'},
      {title:'AI for Science',count:'8.7涓囨鎼滅储',icon:'brain',color:'#a0d0f0'},
      {title:'閲忓瓙璁＄畻',count:'6.5涓囨鎼滅储',icon:'cpu',color:'#c8b0f0'},
      {title:'浜岀淮鏉愭枡',count:'5.2涓囨鎼滅储',icon:'layers',color:'#a0e8c0'},
      {title:'DFT璁＄畻鏁欑▼',count:'4.8涓囨鎼滅储',icon:'book-open',color:'#ffe0a0'}
    ];
    hotList.innerHTML = hotData.map(h => '<div class="list-item" onclick="document.getElementById(\'search-input\').value=\''+h.title+'\';handleSearchSubmit(\''+h.title+'\')"><div class="list-item-icon" style="background:linear-gradient(135deg,'+h.color+','+h.color+'cc)"><i data-lucide="'+h.icon+'" class="lucide icon-white"></i></div><div class="list-item-content"><div class="list-item-title">'+h.title+'</div><div class="list-item-sub">'+h.count+'</div></div><i data-lucide="chevron-right" class="lucide list-item-arrow"></i></div>').join('');
  }
  if (typeof renderIcons === 'function') renderIcons();
}

// 鎼滅储杈撳叆瀹炴椂鑱旀兂
async function handleSearchInput(value) {
  const suggestionsEl = document.getElementById('search-suggestions');
  const resultsEl = document.getElementById('search-results');
  const defaultEl = document.getElementById('search-default');
  
  if (!value.trim()) {
    suggestionsEl.innerHTML = '';
    resultsEl.style.display = 'none';
    defaultEl.style.display = 'block';
    return;
  }
  
  defaultEl.style.display = 'none';
  resultsEl.style.display = 'none';
  
  const suggestions = await Search.suggest(value);
  if (suggestions.length > 0) {
    suggestionsEl.innerHTML = '<div class="card" style="padding:8px">'+suggestions.slice(0,8).map(s => '<div onclick="document.getElementById(\'search-input\').value=\''+s.text+'\';handleSearchSubmit(\''+s.text+'\')" style="display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:10px;cursor:pointer" onmouseover="this.style.background=\'var(--bg-secondary)\'" onmouseout="this.style.background=\'transparent\'"><i data-lucide="'+s.icon+'" class="lucide" style="width:16px;height:16px;color:var(--text3)"></i><span style="font-size:14px;color:var(--text);flex:1">'+s.text+'</span><span style="font-size:11px;color:var(--text3)">'+s.type+'</span></div>').join('')+'</div>';
    if (typeof renderIcons === 'function') renderIcons();
  } else {
    suggestionsEl.innerHTML = '';
  }
}

// 鎻愪氦鎼滅储
async function handleSearchSubmit(keyword) {
  if (!keyword.trim()) return;
  Search.addHistory(keyword);
  
  const suggestionsEl = document.getElementById('search-suggestions');
  const resultsEl = document.getElementById('search-results');
  const defaultEl = document.getElementById('search-default');
  
  suggestionsEl.innerHTML = '';
  defaultEl.style.display = 'none';
  resultsEl.style.display = 'block';
  resultsEl.innerHTML = '<div style="text-align:center;padding:40px">'+UI.loading.spinner(24)+'<p style="font-size:13px;color:var(--text3);margin-top:12px">鎼滅储涓?..</p></div>';
  
  const results = await Search.search(keyword);
  const sources = Object.keys(results);
  
  if (sources.length === 0) {
    resultsEl.innerHTML = UI.state.empty('search', {desc:'鏈壘鍒颁笌"'+keyword+'"鐩稿叧鐨勫唴瀹癸紝璇曡瘯鍏朵粬鍏抽敭璇?});
    return;
  }
  
  let html = '';
  sources.forEach(source => {
    const r = results[source];
