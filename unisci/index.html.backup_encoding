function renderSubPage(pageId) {
  const data = currentData[pageId] || {};

  // === API数据自动同步（fire-and-forget，不阻塞渲染） ===
  if (typeof DataSync !== 'undefined' && !DataSync.isMockMode()) {
    if (['page-compute','page-job-list','page-job-detail','page-job-new','page-results'].includes(pageId)) {
      DataSync.jobs.syncList().then(synced => { if (synced && typeof JobListRenderer !== 'undefined') { try { JobListRenderer.render(); } catch(e){} } });
      if (pageId === 'page-job-detail' && data?.id) DataSync.jobs.syncDetail(data.id);
    }
    if (['page-notebook-list','page-notebook-detail'].includes(pageId)) {
      DataSync.notebooks.syncList().then(synced => { if (synced && typeof NotebookListRenderer !== 'undefined') { try { NotebookListRenderer.render(); } catch(e){} } });
    }
    if (['page-workflow-list','page-workflow-editor'].includes(pageId)) {
      DataSync.workflows.syncList().then(synced => { if (synced && typeof WorkflowListRenderer !== 'undefined') { try { WorkflowListRenderer.render(); } catch(e){} } });
    }
    if (['page-materials','page-material-detail'].includes(pageId)) {
      DataSync.materials.syncList().then(synced => { if (synced && typeof MaterialListRenderer !== 'undefined') { try { MaterialListRenderer.render(); } catch(e){} } });
    }
  }

  if (pageId === 'page-job-detail') {
    if (typeof JobDetailRenderer !== 'undefined') {
      const job = data && data.id ? JobManager.getJob(data.id) : (getCurrentUser().runningJobs[0] || getCurrentUser().completedJobs[0] || {});
      JobDetailRenderer.render(job);
    } else renderJobDetail(data);
  }
  if (pageId === 'page-job-new') { if (typeof NewJobWizard !== 'undefined') NewJobWizard.init(); }
  if (pageId === 'page-results') {
    if (typeof ResultsRenderer !== 'undefined') {
      const job = data && data.id ? JobManager.getJob(data.id) : (getCurrentUser().completedJobs[0] || getCurrentUser().runningJobs[0] || {});
      ResultsRenderer.render(job);
    }
  }
  if (pageId === 'page-notebook-detail') { if (typeof NotebookEditor !== 'undefined') NotebookEditor.init(data); else renderNotebookDetail(data); }
  if (pageId === 'page-article-detail') renderArticleDetail(data);
  if (pageId === 'page-notebook-list') { if (typeof NotebookListRenderer !== 'undefined') NotebookListRenderer.render(); else renderNotebookList(); }
  if (pageId === 'page-settings') { if (typeof SettingsRenderer !== 'undefined') SettingsRenderer.renderMain(); else renderSettings(); }
  if (pageId === 'page-search') initSearchPage();
  if (pageId === 'page-notifications') renderNotifications();
  if (pageId === 'page-login') { if (typeof LoginRenderer !== 'undefined') LoginRenderer.render(); }
  if (pageId === 'page-article-publish') { if (typeof ArticlePublishRenderer !== 'undefined') ArticlePublishRenderer.render(); }
  if (pageId === 'page-my-content') { if (typeof MyContentRenderer !== 'undefined') MyContentRenderer.render(); }
  if (pageId === 'page-workflow-list') { if (typeof WorkflowListRenderer !== 'undefined') WorkflowListRenderer.render(); }
      if (pageId === 'page-workflow-editor') { if (typeof WorkflowEditor !== 'undefined') WorkflowEditor.init(data); }
  if (pageId === 'page-molecules') { if (typeof MoleculeRenderer !== 'undefined') MoleculeRenderer.init(); }
  if (pageId === 'page-materials') { if (typeof MaterialListRenderer !== 'undefined') MaterialListRenderer.render(); }
  if (pageId === 'page-material-detail') { if (typeof MaterialDetailRenderer !== 'undefined') MaterialDetailRenderer.init(data); }
  if (pageId === 'page-knowledge-graph') { if (typeof KnowledgeGraph !== 'undefined') KnowledgeGraph.render(); }
  if (pageId === 'page-experiments') { if (typeof VirtualLab !== 'undefined') VirtualLab.render(); }
  if (pageId === 'page-course-detail') { if (typeof LearningSystem !== 'undefined') LearningSystem.renderCourseDetail(data); else renderCourseDetail(data); }
  if (pageId === 'page-lesson') { if (typeof LearningSystem !== 'undefined') LearningSystem.renderLesson(data); else renderLesson(data); }
}

