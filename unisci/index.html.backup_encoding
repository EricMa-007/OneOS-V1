<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#c7e0f0">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<title>UniSci 路 鍏ㄦ皯绉戝璁＄畻</title>
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
<script src="mock-data.js"></script>
<script src="api.js"></script>
<script src="api-integration.js"></script>
<script src="app-state.js"></script>
<script src="data-sync.js"></script>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --bg1:#b8d4e8;--bg2:#d4e8f5;--bg3:#e8f2fa;
  --card:#fff;--card-shadow:0 8px 32px rgba(100,140,180,0.18),0 2px 8px rgba(100,140,180,0.08);
  --primary:#ff6b4a;--primary2:#ff8c6b;--blue:#5ba3d9;--blue2:#7ec0e8;--blue-light:#e3f1fa;
  --green:#5ccf8e;--green2:#7edda8;--purple:#9b7ed8;--purple2:#b8a0e8;
  --yellow:#ffc857;--pink:#ff8fab;--teal:#5cc9c9;
  --text:#2d3a4a;--text2:#5a6b7d;--text3:#8fa0b3;
  --radius:24px;--radius-sm:16px;--radius-xs:12px;
}
body{font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','Segoe UI',Roboto,sans-serif;
  background:linear-gradient(160deg,var(--bg1) 0%,var(--bg2) 40%,var(--bg3) 100%);
  color:var(--text);min-height:100vh;overflow-x:hidden;padding-bottom:100px;position:relative}
.lucide{width:20px;height:20px;stroke-width:2;flex-shrink:0;pointer-events:none!important}
.icon-lg{width:26px;height:26px}.icon-xl{width:32px;height:32px}.icon-2xl{width:40px;height:40px}
.icon-white{stroke:#fff}.icon-muted{stroke:var(--text3)}
.icon-btn,.quick-item,.card,.nav-item,.ai-chip,.course-card,.new-task-card,.fab,.stat-card,.big-stat-card,.section-more,.list-item,.tab-item,.chip{cursor:pointer;-webkit-tap-highlight-color:transparent}
.icon-btn:active,.quick-item:active,.card:active,.nav-item:active,.ai-chip:active,.course-card:active,.new-task-card:active,.fab:active,.stat-card:active,.big-stat-card:active,.list-item:active,.tab-item:active{transform:scale(0.96)}

.cloud{position:fixed;background:#fff;border-radius:50%;opacity:0.5;z-index:0;pointer-events:none;animation:float 8s ease-in-out infinite}
.c1{width:80px;height:30px;top:60px;right:-20px}.c1::before{content:'';position:absolute;width:40px;height:40px;background:#fff;border-radius:50%;top:-20px;left:15px}
.c2{width:60px;height:22px;top:200px;left:-15px;opacity:0.35;animation-delay:2s}.c2::before{content:'';position:absolute;width:30px;height:30px;background:#fff;border-radius:50%;top:-15px;left:10px}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}

.header{position:relative;z-index:1;padding:20px 20px 8px}
.header-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.logo{display:flex;align-items:center;gap:12px}
.logo-icon{width:46px;height:46px;background:linear-gradient(135deg,var(--primary),var(--primary2));border-radius:14px;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 16px rgba(255,107,74,0.35),inset 0 1px 0 rgba(255,255,255,0.3)}
.logo-text{font-size:20px;font-weight:800;letter-spacing:-0.5px}
.logo-sub{font-size:11px;color:var(--text3);font-weight:500;margin-top:1px}
.header-actions{display:flex;gap:10px}
.icon-btn{width:42px;height:42px;background:var(--card);border-radius:14px;border:none;display:flex;align-items:center;justify-content:center;box-shadow:var(--card-shadow);transition:all 0.2s;position:relative;color:var(--text2)}
.badge-dot{position:absolute;top:9px;right:9px;width:8px;height:8px;background:var(--primary);border-radius:50%;border:2px solid var(--card)}

/* 瀛愰〉闈㈠ご閮?*/
.sub-header{display:flex;align-items:center;gap:12px;padding:16px 20px;position:relative;z-index:1}
.back-btn{width:40px;height:40px;background:var(--card);border-radius:12px;border:none;display:flex;align-items:center;justify-content:center;box-shadow:var(--card-shadow);color:var(--text2)}
.sub-title{font-size:18px;font-weight:800;flex:1}
.sub-action{width:40px;height:40px;background:var(--card);border-radius:12px;border:none;display:flex;align-items:center;justify-content:center;box-shadow:var(--card-shadow);color:var(--text2)}

.welcome-card{background:var(--card);border-radius:var(--radius);padding:20px;box-shadow:var(--card-shadow);position:relative;overflow:hidden;margin-bottom:16px}
.welcome-card::before{content:'';position:absolute;top:-30px;right:-30px;width:120px;height:120px;background:radial-gradient(circle,rgba(91,163,217,0.15),transparent 70%);border-radius:50%}
.welcome-row{display:flex;align-items:center;gap:14px;position:relative;z-index:1}
.avatar{width:56px;height:56px;background:linear-gradient(135deg,var(--blue),var(--blue2));border-radius:18px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:24px;font-weight:700;box-shadow:0 6px 16px rgba(91,163,217,0.3),inset 0 1px 0 rgba(255,255,255,0.3)}
.avatar-purple{background:linear-gradient(135deg,var(--purple),var(--purple2));box-shadow:0 6px 16px rgba(155,126,216,0.3),inset 0 1px 0 rgba(255,255,255,0.3)}
.welcome-text h2{font-size:20px;font-weight:800;margin-bottom:2px}
.welcome-text p{font-size:13px;color:var(--text2)}
.welcome-tag{display:inline-flex;align-items:center;gap:4px;margin-top:6px;padding:4px 10px;background:var(--blue-light);color:var(--blue);border-radius:20px;font-size:11px;font-weight:600}
.welcome-tag-purple{background:linear-gradient(135deg,#f0e8fa,#e4d6f5);color:var(--purple)}
.welcome-tag-green{background:linear-gradient(135deg,#e0f5e8,#d0f0dc);color:var(--green)}

.stats-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}
.stat-card{background:var(--card);border-radius:var(--radius-sm);padding:14px 10px;text-align:center;box-shadow:var(--card-shadow);transition:transform 0.2s;position:relative;overflow:hidden}
.stat-card::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--primary),var(--primary2));border-radius:3px 3px 0 0}
.stat-card.blue::after{background:linear-gradient(90deg,var(--blue),var(--blue2))}
.stat-card.green::after{background:linear-gradient(90deg,var(--green),var(--green2))}
.stat-value{font-size:22px;font-weight:800;line-height:1.2}
.stat-unit{font-size:12px;font-weight:600;color:var(--text3)}
.stat-label{font-size:11px;color:var(--text3);margin-top:4px;font-weight:500}

.container{padding:0 20px;position:relative;z-index:1}
.section-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;margin-top:4px}
.section-title{font-size:17px;font-weight:800;display:flex;align-items:center;gap:10px}
.section-title-icon{width:30px;height:30px;border-radius:10px;display:flex;align-items:center;justify-content:center}
.sti-orange{background:linear-gradient(135deg,#ffe0d6,#ffd0c0);color:var(--primary)}
.sti-blue{background:linear-gradient(135deg,#d6ebf7,#c0e0f2);color:var(--blue)}
.sti-green{background:linear-gradient(135deg,#d6f5e3,#c0edd4);color:var(--green)}
.sti-purple{background:linear-gradient(135deg,#e8dff7,#d4c6f0);color:var(--purple)}
.section-more{font-size:13px;color:var(--text3);font-weight:600;display:flex;align-items:center;gap:2px}

.quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:20px}
.quick-item{display:flex;flex-direction:column;align-items:center;gap:8px}
.quick-icon{width:56px;height:56px;border-radius:18px;display:flex;align-items:center;justify-content:center;color:#fff;transition:all 0.2s;box-shadow:0 6px 14px rgba(100,140,180,0.15),inset 0 1px 0 rgba(255,255,255,0.4)}
.quick-item:active .quick-icon{transform:scale(0.88) translateY(2px)}
.qi-orange{background:linear-gradient(135deg,#ffb8a0,#ff9a7a)}
.qi-blue{background:linear-gradient(135deg,#a0d0f0,#80bde0)}
.qi-green{background:linear-gradient(135deg,#a0e8c0,#80dca8)}
.qi-yellow{background:linear-gradient(135deg,#ffe0a0,#ffd070)}
.qi-pink{background:linear-gradient(135deg,#ffb8c8,#ffa0b0)}
.qi-teal{background:linear-gradient(135deg,#a0e0e0,#80d0d0)}
.qi-purple{background:linear-gradient(135deg,#c8b0f0,#b090e8)}
.qi-gray{background:linear-gradient(135deg,#d0d8e0,#b8c4d0)}
.quick-label{font-size:11px;color:var(--text2);font-weight:600;text-align:center;line-height:1.3}

.card{background:var(--card);border-radius:var(--radius);padding:18px;margin-bottom:12px;box-shadow:var(--card-shadow);transition:all 0.2s;position:relative;overflow:hidden}
.card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}
.card-title{font-size:15px;font-weight:700;display:flex;align-items:center;gap:8px}
.card-badge{font-size:11px;padding:4px 10px;border-radius:20px;font-weight:700;display:flex;align-items:center;gap:5px}
.badge-running{background:linear-gradient(135deg,#e0f5e8,#d0f0dc);color:#2a9d5a}
.badge-queued{background:linear-gradient(135deg,#fff3d6,#ffe8b0);color:#c8880a}
.badge-completed{background:linear-gradient(135deg,#e0ecf8,#d0e0f0);color:#3a7ab8}
.badge-dot-icon{width:6px;height:6px;border-radius:50%;background:currentColor;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}
.job-meta{display:flex;justify-content:space-between;font-size:12px;color:var(--text3);margin-bottom:10px;font-weight:500;align-items:center}
.job-meta span:first-child{display:flex;align-items:center;gap:5px}
.progress-track{height:10px;background:#eef3f8;border-radius:5px;overflow:hidden;position:relative}
.progress-fill{height:100%;border-radius:5px;position:relative;transition:width 0.5s}
.progress-fill::after{content:'';position:absolute;top:0;left:0;right:0;height:50%;background:linear-gradient(180deg,rgba(255,255,255,0.4),transparent);border-radius:5px 5px 0 0}
.pf-orange{background:linear-gradient(90deg,var(--primary),var(--primary2))}
.pf-blue{background:linear-gradient(90deg,var(--blue),var(--blue2))}
.pf-green{background:linear-gradient(90deg,var(--green),var(--green2))}
.pf-purple{background:linear-gradient(90deg,var(--purple),var(--purple2))}

.big-stat-card{background:linear-gradient(135deg,var(--card) 0%,#f8fbfe 100%);border-radius:var(--radius);padding:20px;margin-bottom:12px;box-shadow:var(--card-shadow);position:relative;overflow:hidden}
.big-stat-card::before{content:'';position:absolute;top:-40px;right:-40px;width:140px;height:140px;background:radial-gradient(circle,rgba(255,107,74,0.1),transparent 70%);border-radius:50%}
.big-stat-row{display:flex;align-items:flex-end;gap:8px;margin-bottom:8px;position:relative;z-index:1}
.big-stat-number{font-size:42px;font-weight:900;line-height:1;letter-spacing:-2px}
.big-stat-unit{font-size:16px;font-weight:700;color:var(--text3);padding-bottom:6px}
.big-stat-label{font-size:13px;color:var(--text2);font-weight:600;position:relative;z-index:1;display:flex;align-items:center;gap:6px}
.big-stat-bar{height:8px;background:#eef3f8;border-radius:4px;margin-top:12px;overflow:hidden}
.big-stat-bar-fill{height:100%;background:linear-gradient(90deg,var(--primary),var(--primary2));border-radius:4px}

.ai-card{background:linear-gradient(135deg,#fff5f0 0%,#fff 60%);border-radius:var(--radius);padding:20px;margin-bottom:12px;box-shadow:var(--card-shadow);position:relative;overflow:hidden;border:1px solid rgba(255,107,74,0.1)}
.ai-card::before{content:'';position:absolute;top:-20px;right:-20px;width:100px;height:100px;background:radial-gradient(circle,rgba(255,107,74,0.15),transparent 70%);border-radius:50%}
.ai-header{display:flex;align-items:center;gap:12px;margin-bottom:14px;position:relative;z-index:1}
.ai-avatar{width:48px;height:48px;background:linear-gradient(135deg,var(--primary),var(--primary2));border-radius:16px;display:flex;align-items:center;justify-content:center;color:#fff;box-shadow:0 6px 16px rgba(255,107,74,0.3),inset 0 1px 0 rgba(255,255,255,0.3)}
.ai-name{font-size:16px;font-weight:800}
.ai-status{font-size:11px;color:var(--green);font-weight:600;display:flex;align-items:center;gap:5px;margin-top:2px}
.ai-chips{display:flex;flex-wrap:wrap;gap:8px;position:relative;z-index:1}
.ai-chip{font-size:12px;padding:8px 14px;background:#fff;border-radius:14px;color:var(--text2);font-weight:600;box-shadow:0 2px 8px rgba(100,140,180,0.08);border:1px solid #eef3f8;transition:all 0.2s;display:flex;align-items:center;gap:6px}

.course-card{display:flex;gap:14px;align-items:center}
.course-thumb{width:64px;height:64px;border-radius:18px;display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0;box-shadow:0 4px 12px rgba(100,140,180,0.15),inset 0 1px 0 rgba(255,255,255,0.3)}
.ct-orange{background:linear-gradient(135deg,#ffd0b8,#ffb896)}
.ct-blue{background:linear-gradient(135deg,#b8dcf0,#9ac8e8)}
.ct-green{background:linear-gradient(135deg,#b8e8d0,#9adcb8)}
.ct-purple{background:linear-gradient(135deg,#d0c0f0,#b8a0e8)}
.ct-teal{background:linear-gradient(135deg,#b0e0e0,#90d0d0)}
.course-info{flex:1;min-width:0}
.course-name{font-size:14px;font-weight:700;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.course-meta{font-size:12px;color:var(--text3);font-weight:500;display:flex;align-items:center;gap:6px}
.course-progress-bar{height:6px;background:#eef3f8;border-radius:3px;margin-top:8px;overflow:hidden}
.course-progress-fill{height:100%;border-radius:3px}
.course-progress-text{font-size:11px;font-weight:700;margin-top:4px}

.new-task-card{background:linear-gradient(135deg,var(--primary),var(--primary2));border-radius:var(--radius);padding:20px;margin-bottom:12px;box-shadow:0 8px 24px rgba(255,107,74,0.35);color:#fff;transition:all 0.2s;position:relative;overflow:hidden;display:flex;align-items:center;gap:14px}
.new-task-card::before{content:'';position:absolute;top:-30px;right:-30px;width:120px;height:120px;background:radial-gradient(circle,rgba(255,255,255,0.2),transparent 70%);border-radius:50%}
.new-task-icon{width:48px;height:48px;background:rgba(255,255,255,0.2);border-radius:14px;display:flex;align-items:center;justify-content:center;flex-shrink:0;position:relative;z-index:1;color:#fff}
.new-task-text{position:relative;z-index:1;flex:1}
.new-task-title{font-size:17px;font-weight:800;margin-bottom:3px;display:flex;align-items:center;gap:8px}
.new-task-desc{font-size:13px;opacity:0.9;font-weight:500}

/* 鍒楄〃椤?*/
.list-item{display:flex;align-items:center;gap:12px;padding:14px 16px;background:var(--card);border-radius:var(--radius-sm);margin-bottom:8px;box-shadow:var(--card-shadow);transition:all 0.2s}
.list-item-icon{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0}
.list-item-content{flex:1;min-width:0}
.list-item-title{font-size:14px;font-weight:700;margin-bottom:2px}
.list-item-sub{font-size:12px;color:var(--text3)}
.list-item-arrow{color:var(--text3)}

/* Tab鏍?*/
.tab-bar{display:flex;gap:8px;margin-bottom:16px;overflow-x:auto;padding-bottom:4px}
.tab-item{padding:8px 16px;background:var(--card);border-radius:12px;font-size:13px;font-weight:600;color:var(--text2);white-space:nowrap;box-shadow:var(--card-shadow);transition:all 0.2s;border:none}
.tab-item.active{background:linear-gradient(135deg,var(--primary),var(--primary2));color:#fff}

/* 琛ㄥ崟 */
.form-group{margin-bottom:16px}
.form-label{font-size:13px;font-weight:700;color:var(--text2);margin-bottom:8px;display:block}
.form-input,.form-select{width:100%;padding:12px 16px;background:#f5f8fb;border:2px solid #e8eef4;border-radius:14px;font-size:14px;color:var(--text);outline:none;transition:all 0.2s;font-family:inherit}
.form-input:focus,.form-select:focus{border-color:var(--primary);background:#fff}
.form-textarea{width:100%;padding:12px 16px;background:#f5f8fb;border:2px solid #e8eef4;border-radius:14px;font-size:14px;color:var(--text);outline:none;transition:all 0.2s;font-family:inherit;min-height:100px;resize:vertical}
.chip-row{display:flex;flex-wrap:wrap;gap:8px}
.chip{padding:8px 14px;background:#f5f8fb;border:2px solid #e8eef4;border-radius:12px;font-size:13px;font-weight:600;color:var(--text2);transition:all 0.2s}
.chip.selected{background:linear-gradient(135deg,var(--primary),var(--primary2));color:#fff;border-color:transparent}

/* 鎸夐挳 */
.btn{padding:14px 24px;border-radius:16px;font-size:15px;font-weight:700;border:none;cursor:pointer;transition:all 0.2s;display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%}
.btn-primary{background:linear-gradient(135deg,var(--primary),var(--primary2));color:#fff;box-shadow:0 6px 16px rgba(255,107,74,0.35)}
.btn-secondary{background:var(--card);color:var(--text);box-shadow:var(--card-shadow)}
.btn:active{transform:scale(0.97)}

/* AI瀵硅瘽 */
.chat-container{padding:0 20px 20px;min-height:60vh}
.chat-message{display:flex;gap:10px;margin-bottom:16px;max-width:85%}
.chat-message.user{margin-left:auto;flex-direction:row-reverse}
.chat-avatar{width:36px;height:36px;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0}
.chat-bubble{padding:12px 16px;border-radius:16px;font-size:14px;line-height:1.6}
.chat-message.ai .chat-bubble{background:var(--card);border-bottom-left-radius:6px;box-shadow:var(--card-shadow)}
.chat-message.user .chat-bubble{background:linear-gradient(135deg,var(--primary),var(--primary2));color:#fff;border-bottom-right-radius:6px}
.chat-input-bar{position:fixed;bottom:100px;left:0;right:0;padding:12px 20px;background:rgba(255,255,255,0.95);backdrop-filter:blur(10px);display:flex;gap:10px;z-index:50}
.chat-input{flex:1;padding:12px 16px;background:#f5f8fb;border:2px solid #e8eef4;border-radius:14px;font-size:14px;outline:none;font-family:inherit}
.chat-send{width:44px;height:44px;background:linear-gradient(135deg,var(--primary),var(--primary2));border-radius:14px;border:none;display:flex;align-items:center;justify-content:center;color:#fff;box-shadow:0 4px 12px rgba(255,107,74,0.3)}

/* 鐭ヨ瘑鍥捐氨鑺傜偣 */
.kg-container{background:var(--card);border-radius:var(--radius);padding:20px;box-shadow:var(--card-shadow);min-height:400px;position:relative;overflow:hidden}
.kg-node{position:absolute;padding:10px 16px;background:linear-gradient(135deg,var(--blue-light),#fff);border:2px solid var(--blue2);border-radius:12px;font-size:12px;font-weight:700;color:var(--blue);cursor:pointer;transition:all 0.2s}
.kg-node:hover{transform:scale(1.1);box-shadow:0 4px 12px rgba(91,163,217,0.3)}
.kg-node.center{background:linear-gradient(135deg,var(--primary),var(--primary2));color:#fff;border-color:transparent;font-size:14px;padding:12px 20px}

/* Notebook浠ｇ爜鍧?*/
.nb-cell{background:var(--card);border-radius:var(--radius-sm);padding:16px;margin-bottom:12px;box-shadow:var(--card-shadow)}
.nb-cell-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font-size:11px;color:var(--text3);font-weight:600}
.nb-code{background:#1e293b;color:#e2e8f0;padding:14px;border-radius:10px;font-family:'SF Mono',Consolas,monospace;font-size:12px;line-height:1.6;overflow-x:auto;white-space:pre}
.nb-output{background:#f0f7ff;border-left:3px solid var(--blue);padding:12px;margin-top:10px;border-radius:0 8px 8px 0;font-size:13px;color:var(--text2)}

/* 鏂囩珷璇︽儏 */
.article-detail{background:var(--card);border-radius:var(--radius);padding:24px;box-shadow:var(--card-shadow)}
.article-detail h1{font-size:22px;font-weight:800;margin-bottom:12px;line-height:1.4}
.article-meta-row{display:flex;gap:16px;font-size:12px;color:var(--text3);margin-bottom:20px;flex-wrap:wrap}
.article-body{font-size:15px;line-height:1.8;color:var(--text2)}
.article-body p{margin-bottom:16px}
.article-body h3{font-size:17px;font-weight:700;color:var(--text);margin:24px 0 12px}

/* 鍒嗗瓙寤烘ā */
.molecule-viewer{background:linear-gradient(135deg,#1a1a2e,#16213e);border-radius:var(--radius);height:300px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;margin-bottom:16px}
.molecule-atom{position:absolute;width:24px;height:24px;border-radius:50%;box-shadow:0 0 20px currentColor}
.molecule-bond{position:absolute;height:3px;background:rgba(255,255,255,0.3);transform-origin:left center}

/* 绌虹姸鎬?*/
.empty-state{text-align:center;padding:40px 20px}
.empty-icon{font-size:48px;margin-bottom:12px;opacity:0.5}
.empty-text{font-size:14px;color:var(--text3);font-weight:500}

/* 鐢ㄦ埛鍒囨崲鍣?*/
.user-switcher{background:var(--card);border-radius:var(--radius);padding:16px;margin-bottom:12px;box-shadow:var(--card-shadow)}
.user-switcher-title{font-size:13px;font-weight:700;color:var(--text3);margin-bottom:12px;display:flex;align-items:center;gap:6px}
.user-list{display:flex;flex-direction:column;gap:8px}
.user-option{display:flex;align-items:center;gap:12px;padding:10px 12px;border-radius:14px;transition:all 0.2s;border:2px solid transparent}
.user-option.active{background:linear-gradient(135deg,#fff5f0,#fff);border-color:var(--primary)}
.user-option-avatar{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:18px;font-weight:700;flex-shrink:0}
.user-option-info{flex:1}
.user-option-name{font-size:14px;font-weight:700}
.user-option-role{font-size:11px;color:var(--text3)}
.user-option-check{color:var(--primary);display:none}
.user-option.active .user-option-check{display:block}

/* 鏂囩珷鍗＄墖 */
.article-card{background:var(--card);border-radius:var(--radius);padding:16px;margin-bottom:10px;box-shadow:var(--card-shadow);transition:all 0.2s}
.article-tag{display:inline-block;font-size:10px;padding:2px 8px;border-radius:10px;font-weight:600;margin-bottom:8px}
.article-title{font-size:14px;font-weight:700;margin-bottom:8px;line-height:1.4}
.article-meta{display:flex;justify-content:space-between;font-size:11px;color:var(--text3);align-items:center}
.article-stats{display:flex;gap:12px}
.article-stat{display:flex;align-items:center;gap:3px}

/* Notebook鍗＄墖 */
.notebook-card{background:var(--card);border-radius:var(--radius);padding:16px;margin-bottom:10px;box-shadow:var(--card-shadow);transition:all 0.2s;display:flex;align-items:center;gap:12px}
.notebook-icon{width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0}
.notebook-info{flex:1;min-width:0}
.notebook-title{font-size:14px;font-weight:700;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.notebook-meta{font-size:11px;color:var(--text3);display:flex;gap:10px}

/* 宸ヤ綔娴佸崱鐗?*/
.workflow-card{background:var(--card);border-radius:var(--radius);padding:16px;margin-bottom:10px;box-shadow:var(--card-shadow)}
.workflow-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.workflow-name{font-size:14px;font-weight:700;display:flex;align-items:center;gap:8px}
.workflow-steps{font-size:11px;color:var(--text3);margin-bottom:6px}
.workflow-current{font-size:12px;color:var(--primary);font-weight:600;margin-bottom:8px}

.bottom-nav{position:fixed;bottom:16px;left:16px;right:16px;background:rgba(255,255,255,0.95);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-radius:22px;display:flex;justify-content:space-around;padding:10px 8px;z-index:100;box-shadow:0 10px 40px rgba(100,140,180,0.25),0 2px 8px rgba(100,140,180,0.1);border:1px solid rgba(255,255,255,0.8)}
.nav-item{display:flex;flex-direction:column;align-items:center;gap:3px;padding:6px 12px;border-radius:16px;transition:all 0.25s;position:relative;color:var(--text3)}
.nav-item.active{background:linear-gradient(135deg,var(--primary),var(--primary2));color:#fff;box-shadow:0 4px 12px rgba(255,107,74,0.35)}
.nav-label{font-size:10px;font-weight:700;transition:color 0.25s}

.page{display:none;animation:fadeUp 0.3s cubic-bezier(0.16,1,0.3,1)}
.page.active{display:block}
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}

.toast{position:fixed;top:30px;left:50%;transform:translateX(-50%) translateY(-20px);background:rgba(45,58,74,0.95);backdrop-filter:blur(10px);color:#fff;padding:12px 24px;border-radius:16px;font-size:14px;font-weight:600;z-index:1000;opacity:0;transition:all 0.3s;pointer-events:none;box-shadow:0 8px 24px rgba(0,0,0,0.2);display:flex;align-items:center;gap:8px}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

.fab{position:fixed;bottom:100px;right:20px;width:58px;height:58px;background:linear-gradient(135deg,var(--primary),var(--primary2));border-radius:20px;display:flex;align-items:center;justify-content:center;color:#fff;box-shadow:0 8px 24px rgba(255,107,74,0.4),inset 0 1px 0 rgba(255,255,255,0.3);z-index:99;border:none;transition:all 0.2s}

/* 闅愯棌瀛愰〉闈㈢殑搴曢儴瀵艰埅 */
.sub-page .bottom-nav{display:none}

/* Notebook缂栬緫鍣ㄦ牱寮?*/
.notebook-cell{background:var(--card);border-radius:var(--radius-sm);margin-bottom:12px;box-shadow:var(--card-shadow);border:2px solid transparent;transition:all 0.2s;overflow:hidden}
.notebook-cell.selected{border-color:var(--primary);box-shadow:0 0 0 3px rgba(255,107,74,0.15)}
.cell-header{display:flex;align-items:center;justify-content:space-between;padding:8px 12px;background:var(--bg-secondary);border-bottom:1px solid var(--border)}
.cell-type-badge{font-size:10px;font-weight:700;padding:2px 8px;border-radius:6px}
.cell-type-badge.code{background:rgba(91,163,217,0.15);color:var(--blue)}
.cell-type-badge.md{background:rgba(155,126,216,0.15);color:var(--purple)}
.cell-exec-count{font-size:11px;color:var(--text3);font-family:monospace;margin-left:auto;margin-right:8px}
.cell-actions{display:flex;gap:2px}
.cell-btn{background:none;border:none;cursor:pointer;padding:4px 6px;border-radius:6px;color:var(--text3);display:flex;align-items:center;justify-content:center;transition:all 0.15s}
.cell-btn:hover{background:var(--border);color:var(--text)}
.cell-btn:disabled{opacity:0.5;cursor:not-allowed}
.cell-input{width:100%;border:none;outline:none;padding:12px;font-size:13px;line-height:1.6;background:transparent;resize:vertical;min-height:60px;font-family:'SF Mono',Consolas,monospace;color:var(--text)}
.code-cell{background:#fafbfc;border-top:1px solid var(--border)}
.markdown-cell{font-family:-apple-system,sans-serif;white-space:pre-wrap}
.cell-output{padding:12px;background:#f8fafc;border-top:1px solid var(--border);font-size:12px;line-height:1.6}
.cell-output pre{margin:0;white-space:pre-wrap;word-break:break-all;font-family:'SF Mono',Consolas,monospace;color:var(--text2)}
.cell-output.error{background:#fef2f2}
.loading-spinner{display:inline-block;width:12px;height:12px;border:2px solid var(--border);border-top-color:var(--primary);border-radius:50%;animation:spin 0.8s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* 椤甸潰鍒囨崲娣″叆鍔ㄧ敾 */
.page{opacity:0;transform:translateY(8px);transition:opacity 0.25s ease,transform 0.25s ease}
.page.active{opacity:1;transform:translateY(0)}

/* 鍗＄墖鐐瑰嚮鍙嶉 */
.card{transition:transform 0.15s ease,box-shadow 0.15s ease}
.card:active{transform:scale(0.98)}

/* 鎸夐挳鐐瑰嚮鍙嶉 */
.btn{transition:transform 0.12s ease,opacity 0.12s ease}
.btn:active{transform:scale(0.96);opacity:0.9}

/* 鍐呭鍔犺浇娣″叆 */
@keyframes fadeInUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.fade-in{animation:fadeInUp 0.3s ease forwards}

/* 绌虹姸鎬佹牱寮?*/
.empty-state{text-align:center;padding:40px 20px;color:var(--text3)}
.empty-state .empty-icon{font-size:48px;margin-bottom:12px;opacity:0.5}
.empty-state .empty-text{font-size:14px;line-height:1.6}

/* 楠ㄦ灦灞忓姞杞?*/
.skeleton{background:linear-gradient(90deg,var(--bg-secondary) 25%,var(--bg-tertiary) 50%,var(--bg-secondary) 75%);background-size:200% 100%;animation:skeleton 1.5s infinite;border-radius:8px}
@keyframes skeleton{0%{background-position:200% 0}100%{background-position:-200% 0}}

/* Tab鍒囨崲杩囨浮 */
.tab-item{transition:all 0.2s ease}
.tab-item.active{transform:scale(1.02)}

/* 杩涘害鏉″姩鐢?*/
