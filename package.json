{
  "name": "oneos",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "OneOS - 每个人的第二大脑和数字生存操作系统",
  "author": "OneOS Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "---- 开发 ----": "",
    "dev": "vite",
    "dev:host": "vite --host",
    "dev:mobile": "vite --host --mode mobile",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "---- 构建 ----": "",
    "build": "vite build",
    "build:prod": "vite build --mode production",
    "build:analyze": "vite build --mode analyze",
    "build:mobile": "vite build --mode mobile",
    "---- 代码检查 ----": "",
    "lint": "eslint src/ components/ --ext .js,.jsx --format stylish",
    "lint:fix": "eslint src/ components/ --ext .js,.jsx --fix",
    "lint:report": "eslint src/ components/ --ext .js,.jsx --format json --output-file eslint-report.json",
    "format": "prettier --write \"src/**/*.{js,jsx,css,json}\" \"components/**/*.{js,jsx}\" \"styles/**/*.css\" \"*.{md,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css,json}\" \"components/**/*.{js,jsx}\" \"styles/**/*.css\"",
    "commitlint": "commitlint --edit",
    "---- 测试 ----": "",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "vitest run --coverage --coverage.100=false",
    "test:ci": "vitest run --reporter=verbose",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:perf": "node tests/performance-test.cjs",
    "---- 性能 ----": "",
    "perf:benchmark": "node tests/performance/benchmark.js",
    "perf:check": "node tests/performance/check.js",
    "perf:lighthouse": "lhci autorun",
    "---- 数据库 ----": "",
    "db:migrate": "node scripts/migrate.js",
    "db:backup": "node scripts/backup.js",
    "db:restore": "node scripts/restore.js",
    "---- 文档 ----": "",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "---- 发布 ----": "",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:patch": "standard-version --release-as patch",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "---- Git Hooks ----": "",
    "prepare": "husky install",
    "---- 其他 ----": "",
    "clean": "rimraf dist coverage .eslintcache *.tsbuildinfo",
    "clean:all": "rimraf dist coverage node_modules .eslintcache *.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "analyze": "vite build --mode analyze && npx vite-bundle-optimizer"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "date-fns": "^3.3.0",
    "dompurify": "^3.0.0",
    "fuse.js": "^7.0.0",
    "marked": "^12.0.0",
    "nanoid": "^5.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.5.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.3.0",
    "@vitest/ui": "^1.3.0",
    "conventional-changelog-cli": "^4.1.0",
    "cypress": "^13.6.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^9.0.0",
    "jsdom": "^24.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "rimraf": "^5.0.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "standard-version": "^9.5.0",
    "vite": "^5.1.0",
    "vite-plugin-pwa": "^0.19.0",
    "vitest": "^1.3.0"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "standard-version": {
    "types": [
      {
        "type": "feat",
        "section": "✨ 新功能"
      },
      {
        "type": "fix",
        "section": "🐛 Bug修复"
      },
      {
        "type": "perf",
        "section": "⚡ 性能优化"
      },
      {
        "type": "refactor",
        "section": "♻️ 代码重构"
      },
      {
        "type": "docs",
        "section": "📝 文档更新"
      },
      {
        "type": "test",
        "section": "✅ 测试相关"
      },
      {
        "type": "build",
        "section": "📦 构建系统"
      },
      {
        "type": "ci",
        "section": "🔧 CI/CD"
      },
      {
        "type": "chore",
        "section": "🔨 杂项",
        "hidden": false
      },
      {
        "type": "style",
        "section": "💄 代码格式",
        "hidden": false
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
